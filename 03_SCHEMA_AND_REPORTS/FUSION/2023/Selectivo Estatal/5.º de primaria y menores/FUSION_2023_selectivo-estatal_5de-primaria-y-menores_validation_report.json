        "proofAlgorithm": "function(size,shapes){\n var full=(1n<<BigInt(size*size))-1n,placements=[],byCell=Array.from({length:size*size},()=>[]);\n for(var [oi,shape]of shapes.entries()){var w=Math.max(...shape.map(c=>c[0]))+1,h=Math.max(...shape.map(c=>c[1]))+1;for(var y=0;y<=size-h;y++)for(var x=0;x<=size-w;x++){var cs=shape.map(([dx,dy])=>[x+dx,y+dy]);var mask=cs.reduce((m,[px,py])=>m|(1n<<BigInt(py*size+px)),0n);var pi=placements.length;placements.push({orientation:oi,x,y,cells:cs,mask});for(var [px,py]of cs)byCell[py*size+px].push(pi);}}\n var nodes=0,dead=new Set();\n var search=function(used,chosen){nodes++;if(used===full)return chosen;if(dead.has(used.toString()))return null;var best=null;for(var cell=0;cell<size*size;cell++)if(!(used&(1n<<BigInt(cell)))){var opts=byCell[cell].filter(pi=>!(used&placements[pi].mask));if(!opts.length)return null;if(!best||opts.length<best.length)best=opts;if(best.length===1)break;}for(var pi of best){var out=search(used|placements[pi].mask,[...chosen,pi]);if(out)return out;}dead.add(used.toString());return null;};\n var sol=search(0n,[]);return{size,orientations:shapes.length,placementCount:placements.length,searchNodes:nodes,solution:sol?.map(pi=>{var p=placements[pi];return{orientation:p.orientation,x:p.x,y:p.y,cells:p.cells};})||null,exhaustive:!sol};\n}",
        "cornerCaseAlgorithm": "function(size,shapes){\n var full=(1n<<BigInt(size*size))-1n,placements=[],byCell=Array.from({length:size*size},()=>[]);\n for(var shape of shapes){var w=Math.max(...shape.map(c=>c[0]))+1,h=Math.max(...shape.map(c=>c[1]))+1;for(var y=0;y<=size-h;y++)for(var x=0;x<=size-w;x++){var cells=shape.map(([dx,dy])=>[x+dx,y+dy]),mask=cells.reduce((m,[px,py])=>m|(1n<<BigInt(py*size+px)),0n),index=placements.length;placements.push({cells,mask});for(var [px,py]of cells)byCell[py*size+px].push(index);}}\n var branches=0;var dfs=function(used){branches++;if(used===full)return true;var best=null;for(var k=0;k<size*size;k++)if(!(used&(1n<<BigInt(k)))){var opts=byCell[k].filter(i=>!(used&placements[i].mask));if(!opts.length)return false;if(!best||opts.length<best.length)best=opts;}for(var i of best)if(dfs(used|placements[i].mask))return true;return false;};\n return byCell[0].map(i=>{var before=branches,sol=dfs(placements[i].mask);return{firstPiece:placements[i].cells,remainingSearchNodes:branches-before,completion:sol};});\n}",
