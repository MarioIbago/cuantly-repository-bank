  "review_items": [
    {
      "problem_number": 10,
      "status": "timing_inconsistency_needs_review",
      "issue": "El intervalo total es 180 min. La respuesta prevista parece 9 por ciclos de 20 min, pero tras el noveno tramo de 15 min se llegaría a las 11:55; tomar el noveno descanso desplaza la 'llegada' al final del descanso."
    },
    {
      "problem_number": 11,
      "status": "ambiguous_duplicate_correct_options",
      "issue": "Las opciones a y c son idénticas: ambas dicen 270 saltos, y 270 es el resultado correcto."
    },
    {
      "problem_number": 14,
      "status": "verified_with_wording_interpretation",
      "issue": "Se interpreta que pide el número de pares de líneas perpendiculares; hay 3 pares."
    },
    {
      "problem_number": 15,
      "status": "verified_with_geometry_convention",
      "issue": "El área del rombo y del romboide no queda determinada solo por sus lados. La opción a es la respuesta escolar prevista; un rombo no cuadrado de lado 4 tiene área menor que 16 cm²."
    },
    {
      "problem_number": 24,
      "status": "verified_with_implicit_assumption",
      "issue": "La opción d ($30) requiere asumir que los dos helados consumen exactamente todo el dinero que quedaba."
    }
  ],
